NODE_ENV=development
PORT=4017
WORKER_ID=1

POSTGRES_USER=media_user
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=media_service
POSTGRES_PORT=5433
DATABASE_URL=postgresql://media_user:<change-me>@localhost:5433/media_service

JWT_SECRET=<min-32-char-random-secret>
AUTH_ISSUER=media-auth
AUTH_AUDIENCE=media-api

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
STORAGE_PUBLIC_BASE_URL=http://localhost:4017
UPLOAD_SIGNING_SECRET=<min-32-char-random-secret>
PRESIGNED_URL_TTL_SECONDS=300

MAX_UPLOAD_BYTES=10485760
DEFAULT_TENANT_QUOTA_BYTES=1073741824
WORKER_POLL_MS=1000
